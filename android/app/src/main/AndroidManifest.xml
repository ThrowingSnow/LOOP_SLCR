<?xml version="1.0" encoding="utf-8"?>
<!--
    No permissions are declared here. Files arrive through the Storage Access
    Framework, which grants access to the one file the user picked and nothing
    else — so the app never has to ask for the right to read all of their
    storage, and the answer to "what can it see" is "what you handed it".

    The built APK does carry one: `DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION`,
    which AndroidX declares for itself. It is signature-level and scoped to this
    package, and it grants nothing outside it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        A large heap because the file is decoded whole: a five-minute stereo
        file at 48 kHz becomes about 230 MB of 64-bit samples before the
        pipeline copies it once. This is a request, not a guarantee — the app
        still has to survive being refused, which is why the failure path
        catches Throwable rather than Exception.
    -->
    <application
        android:largeHeap="true"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoopSlcr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LoopSlcr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
