<?xml version="1.0" encoding="utf-8"?>
<!--
    No permissions are declared here. Files arrive through the Storage Access
    Framework, which grants access to the one file the user picked and nothing
    else — so the app never has to ask for the right to read all of their
    storage, and the answer to "what can it see" is "what you handed it".

    The built APK does carry one: `DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION`,
    which AndroidX declares for itself. It is signature-level and scoped to this
    package, and it grants nothing outside it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LoopSlcr">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.LoopSlcr">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
